[TEMPLATE]
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_id_here
# Simpan target voice ke voice-targets.json agar bot kembali ke room setelah restart (default: true).
# Set false untuk TIDAK menulis file apa pun; trade-off: setelah restart, user harus /join lagi.
PERSIST_TARGETS=true
